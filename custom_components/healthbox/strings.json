{
    "config": {
        "flow_title": "Healthbox Configuration",
        "step": {
            "user": {
                "description": "If you need help with the configuration have a look here: https://github.com/rmassch/healthbox3",
                "data": {
                    "host": "[%key:common::config_flow::data::host%]",
                    "api_key": "[%key:common::config_flow::data::api_key%]"
                }
            },
            "reauth_confirm": {
                "title": "Re-authenticate Healthbox",
                "description": "The API key for the Healthbox at {host} was rejected. Enter a valid API key.",
                "data": {
                    "api_key": "[%key:common::config_flow::data::api_key%]"
                }
            }
        },
        "error": {
            "auth": "API Key is wrong.",
            "connection": "Unable to connect to the Healthbox 3 Unit.",
            "unknown": "[%key:common::config_flow::error::unknown%]"
        },
        "abort": {
            "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
            "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
        }
    },
    "options": {
        "flow_title": "Healthbox Configuration",
        "step": {
            "init": {
                "data": {
                    "api_key": "[%key:common::config_flow::data::api_key%]"
                }
            }
        },
        "error": {
            "auth": "API Key is wrong.",
            "connection": "Unable to connect to the Healthbox 3 Unit.",
            "unknown": "[%key:common::config_flow::error::unknown%]"
        }
    }
}
